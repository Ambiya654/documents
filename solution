/*=========================================================
 SAVE IDEA / SAVE AS DRAFT
=========================================================*/
$(document).on('click', '#btnSaveIdea', function () {
    var id = parseInt($(this).attr('data-id')) || 0;
    saveIdea(false, id);
});

$(document).on('click', '#btnSaveDraft', function () {
    var id = parseInt($('#btnSaveIdea').attr('data-id')) || 0;
    saveIdea(true, id);
});

function saveIdea(isDraft, ideaID) {

    var ideaTitle = $('#txtIdeaTitle').val().trim();
    // use .val() even if disabled — disabled fields hold their value
    var problemStatement = $('#txtProblemStatement').val().trim();
    var currentSituation = $('#txtCurrentSituation').val().trim();

    // collect proposed ideas
    var proposedIdeas = [];
    var blockError = false;

    $('.idea-details').each(function () {
        var proposed = $(this).find('.proposed-idea-text').val().trim();
        var detailed = $(this).find('.detailed-explanation-text').val().trim();

        if (proposed === '' || detailed === '') {
            blockError = true;
            return false; // break $.each
        }

        proposedIdeas.push({
            ProposedIdea: proposed,
            DetailedExplanation: detailed
        });
    });

    //-----------------------------------
    // VALIDATION
    //-----------------------------------
    var errors = [];

    if (ideaTitle === '')
        errors.push('Please enter Idea Title');

    if (problemStatement === '')
        errors.push('Please enter Problem Statement');

    if (currentSituation === '')
        errors.push('Please enter Current Situation');

    if (blockError || proposedIdeas.length === 0)
        errors.push('Please fill all Proposed Idea and Detailed Explanation fields');

    if (errors.length > 0) {
        showError(errors.join('<br>'));
        return;
    }

    //-----------------------------------
    // ACTION: INSERT vs UPDATE
    //-----------------------------------
    var action = (ideaID && ideaID > 0) ? 'UPDATE' : 'INSERT';

    /*
     STATUS ID LOGIC:
       INSERT draft  → 7  (Draft)
       INSERT submit → 2  (Pending Review — SP DELETE only allows StatusID=2)
       UPDATE draft  → 7
       UPDATE submit → 2
    */
    var statusID = isDraft ? 7 : 2;

    var payload = {
        Action: action,
        IdeaID: ideaID || 0,
        ThemeID: selectedThemeID || null,
        IdeaTitle: ideaTitle,
        ProblemStatement: problemStatement,
        CurrentSituation: currentSituation,
        IsDraft: isDraft,
        StatusID: statusID,
        ProposedIdeas: proposedIdeas
        // LoginEmployee & LoginIPAddress injected server-side from session
    };

    // show loader
    $('#btnSaveIdea, #btnSaveDraft').prop('disabled', true);

    $.ajax({
        url: appUrl + 'AIM/SaveUpdateDeleteIdea',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload),

        success: function (res) {
            $('#btnSaveIdea, #btnSaveDraft').prop('disabled', false);

            if (res.responseCode === 1) {
                showSuccess(res.responseMessage);
                closePopupAndReset();
                // TODO: reload idea listing here once GetIdeaList endpoint is wired
                // loadIdeaList();
            } else {
                showError(res.responseMessage || 'Something went wrong');
            }
        },

        error: function (xhr) {
            $('#btnSaveIdea, #btnSaveDraft').prop('disabled', false);
            showError('Request failed. Status: ' + xhr.status);
        }
    });
}

/*=========================================================
 DELETE IDEA
 Call this from the Delete action button in the listing.
 Pass the IdeaID.
 Only StatusID=2 (Pending Review) ideas can be deleted per SP.
=========================================================*/
function deleteIdea(ideaID) {
    if (!ideaID || ideaID <= 0) {
        showError('Invalid Idea ID');
        return;
    }

    if (!confirm('Are you sure you want to delete this idea? Only Pending Review ideas can be deleted.')) {
        return;
    }

    var payload = {
        Action: 'DELETE',
        IdeaID: ideaID
        // LoginEmployee & LoginIPAddress injected server-side
    };

    $.ajax({
        url: appUrl + 'AIM/SaveUpdateDeleteIdea',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload),

        success: function (res) {
            if (res.responseCode === 1) {
                showSuccess(res.responseMessage);
                // TODO: reload idea listing
                // loadIdeaList();
            } else {
                showError(res.responseMessage || 'Delete failed');
            }
        },

        error: function (xhr) {
            showError('Delete request failed. Status: ' + xhr.status);
        }
    });
}

// Wire delete buttons in the listing
$(document).on('click', '.delete-idea', function () {
    var ideaID = parseInt($(this).data('id')) || 0;
    deleteIdea(ideaID);
});

/*=========================================================
 CLOSE POPUP + RESET
=========================================================*/
function closePopupAndReset() {
    resetIdeaForm();
    $('.addIdeaPopup').removeClass('active');
    $('#addUserOverlay').fadeOut();
    $('body').removeClass('no-scroll');
}

/*=========================================================
 RESET FORM
=========================================================*/
function resetIdeaForm() {
    selectedThemeID = null;
    editIdeaID = 0;

    $('#txtIdeaTitle').val('');
    $('#txtProblemStatement').val('').prop('disabled', false);
    $('#txtCurrentSituation').val('').prop('disabled', false);

    // keep only the first block and clear its values
    $('.idea-details').not(':first').remove();
    $('.idea-details:first .proposed-idea-text').val('');
    $('.idea-details:first .detailed-explanation-text').val('');

    $('#btnSaveIdea').attr('data-id', 0).text('Save Idea');
}















