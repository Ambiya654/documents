using Microsoft.Data.SqlClient;
using Newtonsoft.Json;
using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace DNA.Infrastructure.Repositories
{
    public class AimRepository : IAimRepository
    {
        private readonly DBConnection _dbConnection;

        public AimRepository(DBConnection dbConnection)
        {
            _dbConnection = dbConnection;

        }
        public Task<ApiResponse> SaveUpdateDeleteGroup(SaveUpdateDeleteGroupModel request)
        {
            try
            {
                var outParams = new List<OutParameter>();

                var parameters = new SqlParameter[]
                {
            new SqlParameter("@Action", request.Action ?? (object)DBNull.Value),
            new SqlParameter("@TID", request.TID),
            new SqlParameter("@GroupName", request.GroupName ?? (object)DBNull.Value),
            new SqlParameter("@GroupDescription", request.GroupDescription ?? (object)DBNull.Value),
            new SqlParameter("@LoginEmployee", request.LoginEmployee ?? (object)DBNull.Value),
            new SqlParameter("@LoginIPAddress", request.LoginIPAddress ?? (object)DBNull.Value),

            new SqlParameter("@rcode", SqlDbType.Int)
            {
                Direction = ParameterDirection.Output
            },

            new SqlParameter("@rmessage", SqlDbType.VarChar, 500)
            {
                Direction = ParameterDirection.Output
            }
                };

                _dbConnection.ExecuteNonQuery(
                    "DNA_PRC_SaveUpdateDeleteGroup",
                    parameters,
                    outParams
                );

                var rcodeObj = parameters.First(p => p.ParameterName == "@rcode").Value;
                var rmessageObj = parameters.First(p => p.ParameterName == "@rmessage").Value;

                int rcode = (rcodeObj == null || rcodeObj == DBNull.Value)
                    ? 0
                    : Convert.ToInt32(rcodeObj);

                string rmessage = (rmessageObj == null || rmessageObj == DBNull.Value)
                    ? "No response from procedure"
                    : rmessageObj.ToString();

                return Task.FromResult(new ApiResponse
                {
                    ResponseCode = rcode,
                    ResponseMessage = rmessage
                });
            }
            catch (Exception ex)
            {
                return Task.FromResult(new ApiResponse
                {
                    ResponseCode = 0,
                    ResponseMessage = ex.Message
                });
            }
        }
        // =============================
        // SERVICE METHOD
        // Get List / Get Single Record
        // =============================
        public Task<ApiResponse> GetGroupDetailsAndEdit(GetGroupDetailAndEditModel request)
        {
            try
            {
                var outParams = new List<OutParameter>();

                var parameters = new SqlParameter[]
                {
            new SqlParameter("@TID", request.TID),
            new SqlParameter("@PageNo", request.PageNo),
            new SqlParameter("@SearchText", request.SearchText ?? (object)DBNull.Value),

            new SqlParameter("@rcode", SqlDbType.Int)
            {
                Direction = ParameterDirection.Output
            },

            new SqlParameter("@rmessage", SqlDbType.VarChar, 500)
            {
                Direction = ParameterDirection.Output
            }
                };

                DataSet ds = _dbConnection.ExecuteDataSetSafe(
                    "DNA_PRC_GetGroupDetails",
                    parameters,
                    outParams
                );

                var rcodeObj = parameters.First(p => p.ParameterName == "@rcode").Value;
                var rmessageObj = parameters.First(p => p.ParameterName == "@rmessage").Value;

                int rcode = (rcodeObj == null || rcodeObj == DBNull.Value)
                    ? 0
                    : Convert.ToInt32(rcodeObj);

                string rmessage = (rmessageObj == null || rmessageObj == DBNull.Value)
                    ? "No response from procedure"
                    : rmessageObj.ToString();

                string jsonResult = "";

                // ---------------------------------------
                // EDIT MODE (Single Record)
                // ---------------------------------------
                if (request.TID > 0)
                {
                    if (ds.Tables.Count > 0)
                        jsonResult = JsonConvert.SerializeObject(ds.Tables[0]);
                }
                else
                {
                    // ---------------------------------------
                    // LIST MODE + PAGINATION
                    // Table0 = Data
                    // Table1 = Paging
                    // ---------------------------------------
                    var result = new
                    {
                        GroupList = ds.Tables.Count > 0 ? ds.Tables[0] : null,
                        Pagination = ds.Tables.Count > 1 ? ds.Tables[1] : null
                    };

                    jsonResult = JsonConvert.SerializeObject(result);
                }

                return Task.FromResult(new ApiResponse
                {
                    ResponseCode = rcode,
                    ResponseMessage = rmessage,
                    ResponseData = jsonResult
                });
            }
            catch (Exception ex)
            {
                return Task.FromResult(new ApiResponse
                {
                    ResponseCode = 0,
