}

// Company dept subprocess Bind

// Company change → load departments
$(document).on('change', '#ddlcompany', function () {

    var companyCode = $(this).val();

    loadDepartments(companyCode);
});


// Department change → load subprocess
$(document).on('change', '#ddldepartment', function () {

    var companyCode = $('#ddlcompany').val();
    var deptCodes = $(this).val(); // array (multi-select)

    loadSubProcess(companyCode, deptCodes);
});
function loadCompanies() {

    $.ajax({
        url: appUrl + 'AIM/GetCompanyDeptSubProcess',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ Action: 'COMPANY' }),

        success: function (res) {

            if (res.responseCode === 1) {

                var data = JSON.parse(res.responseData);
                console.log("Company Data:", data);

                var $ddl = $('#ddlcompany');

                var html = '<option value="">Select</option>';

                $.each(data, function (i, item) {
                    html += `<option value="${item.CompanyCode}">
                                ${item.CompanyName}
                             </option>`;
                });

                // ✅ Destroy old Select2 (if exists)
                if ($ddl.hasClass("select2-hidden-accessible")) {
                    $ddl.select2('destroy');
                }

                // ✅ Bind options
                $ddl.html(html);

                // ✅ Reinitialize Select2
                $ddl.select2({
                    placeholder: "Select Company",
                    allowClear: true,
                    width: '100%'
                });
            }
        }
    });
}
function loadDepartments(companyCode) {

    if (!companyCode) {
        $('#ddldepartment').html('').trigger('change');
        $('#ddlsubprocess').html('').trigger('change');
        return;
    }

    $.ajax({
        url: appUrl + 'AIM/GetCompanyDeptSubProcess',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            Action: 'DEPARTMENT',
            CompanyCode: companyCode
        }),

        success: function (res) {

            if (res.responseCode === 1) {

                var data = JSON.parse(res.responseData);
                console.log("Department Data:", data);

                var $ddl = $('#ddldepartment');

                var html = '';

                $.each(data, function (i, item) {
                    html += `<option value="${item.DeptCode}">
                                ${item.Dept}
                             </option>`;
                });

                // Destroy select2 if already initialized
                if ($ddl.hasClass("select2-hidden-accessible")) {
                    $ddl.select2('destroy');
                }

                // Bind
                $ddl.html(html);

                // Reinit
                $ddl.select2({
                    placeholder: "Select Department",
                    width: '100%'
                });

                // Clear subprocess
                $('#ddlsubprocess').html('').trigger('change');
            }
        }
    });
}
function loadSubProcess(companyCode, deptCodes) {

    if (!companyCode || !deptCodes || deptCodes.length === 0) {
        $('#ddlsubprocess').html('').trigger('change');
        return;
    }

    $.ajax({
        url: appUrl + 'AIM/GetCompanyDeptSubProcess',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            Action: 'SUBPROCESS',
            CompanyCode: companyCode,
            DepartmentCode: deptCodes.join(',') // 🔥 important
        }),

        success: function (res) {

            if (res.responseCode === 1) {

                var data = JSON.parse(res.responseData);
                console.log("SubProcess Data:", data);

                var $ddl = $('#ddlsubprocess');

                var html = '';

                $.each(data, function (i, item) {
                    html += `<option value="${item.SubProcessCode}">
                                ${item.SubProcess}
                             </option>`;
                });

                // Destroy select2
                if ($ddl.hasClass("select2-hidden-accessible")) {
                    $ddl.select2('destroy');
                }

                // Bind
                $ddl.html(html);

                // Reinit
                $ddl.select2({
                    placeholder: "Select Sub Process",
                    width: '100%'
                });
            }
        }
    });
}












