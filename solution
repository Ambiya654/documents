/*=========================================================
 PAGINATION GROUP
=========================================================*/
function bindPagination(totalRecords) {

    var totalPages = Math.ceil(totalRecords / pageSize);

    if (totalPages <= 0) totalPages = 1;

    var startRecord = ((currentPage - 1) * pageSize) + 1;
    var endRecord = currentPage * pageSize;

    if (endRecord > totalRecords)
        endRecord = totalRecords;

    if (totalRecords === 0) {
        startRecord = 0;
        endRecord = 0;
    }

    var html = '';

    html += `
    <div class="pagination-cntr mb-4">

        <p class="mb-0 text-muted">
            Showing <strong>${startRecord}</strong> to 
            <strong>${endRecord}</strong> out of
            <span class="text-success fw-semibold">${totalRecords}</span> results
        </p>

        <nav>
            <ul class="pagination mb-0">`;

    /* PREVIOUS */
    html += `
    <li class="page-item ${currentPage == 1 ? 'disabled' : ''}">
        <a class="page-link group-page-click" href="javascript:;" data-page="${currentPage - 1}">
            <span><i class="bi bi-chevron-left"></i></span>
        </a>
    </li>`;

    /* PAGE NUMBERS */
    for (var i = 1; i <= totalPages; i++) {

        html += `
        <li class="page-item ${currentPage == i ? 'active' : ''}">
            <a class="page-link group-page-click" href="javascript:;" data-page="${i}">
                ${i}
            </a>
        </li>`;
    }

    /* NEXT */
    html += `
    <li class="page-item ${currentPage == totalPages ? 'disabled' : ''}">
        <a class="page-link group-page-click" href="javascript:;" data-page="${currentPage + 1}">
            <span><i class="bi bi-chevron-right"></i></span>
        </a>
    </li>`;

    /* LAST */
    html += `
    <li class="page-item ${currentPage == totalPages ? 'disabled' : ''}">
        <a class="page-link group-page-click" href="javascript:;" data-page="${totalPages}">
            <span><i class="bi bi-chevron-double-right"></i></span>
        </a>
    </li>`;

    html += `
            </ul>
        </nav>
    </div>`;

    $('.group-pagination').html(html);
}


