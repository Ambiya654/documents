    if (groupDetail === '') {
        errors.push('Please enter Group Detail');
    }

    if (errors.length > 0) {
        showError(errors.join('<br>'));
        return;
    }

    var payload = {
        Action: tid == 0 ? 'INSERT' : 'UPDATE',
        TID: tid,
        GroupName: groupName,
        GroupDescription: groupDetail
    };

    $.ajax({
        url: appUrl + 'AIM/SaveUpdateDeleteGroup',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload),

        success: function (res) {

            if (res.responseCode === 1) {

                showSuccess(res.responseMessage);

                $('.addGroupPopup input[type="text"]').val('');
                $('.addGroupPopup textarea').val('');

                $('.addGroupPopup .btn-success')
                    .attr('data-id', 0)
                    .text('Save');

                $('.addGroupPopup').removeClass('open active');

                loadGroupList(currentPage);

            } else {
                showError(res.responseMessage);
            }
        },

        error: function () {
            showError('Something went wrong');
        }
    });

});


