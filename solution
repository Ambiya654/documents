CREATE PROCEDURE [dbo].[DNA_PRC_SaveUpdateDeleteIdea]  
(  
    @Action              VARCHAR(20),  
    @IdeaID              INT = 0,  
  
    @ThemeID             INT = NULL,  
  
    @IdeaTitle           NVARCHAR(200) = NULL,  
    @ProblemStatement    NVARCHAR(500) = NULL,  
  
    @CurrentSituation    NVARCHAR(500) = NULL,  
  
    @Company             NVARCHAR(200) = NULL,  
    @CompanyCode         NVARCHAR(150) = NULL,  
  
    @LocationCode        NVARCHAR(100) = NULL,  
    @LocationName        NVARCHAR(100) = NULL,  
  
    @DepartmentCode      NVARCHAR(150) = NULL,  
    @DepartmentName      NVARCHAR(150) = NULL,  
  
    @SubProcessCode      NVARCHAR(150) = NULL,  
    @SubProcessName      NVARCHAR(150) = NULL,  
  
    @StatusID            INT = NULL,  
    @IdeaTypeID          INT = NULL,  
    @FeasibilityID       INT = NULL,  
  
    @IsDraft             BIT = 0,  
    @ProposedIdeasJSON   NVARCHAR(MAX) = NULL,  
  
    @LoginEmployee       VARCHAR(100) = NULL,  
    @LoginIPAddress      VARCHAR(50) = NULL,  
  
    @rcode               INT OUTPUT,  
    @rmessage            VARCHAR(500) OUTPUT  
)  
AS  
BEGIN  
    SET NOCOUNT ON;  
  
    SET @rcode = 0;  
    SET @rmessage = '';  
  
    BEGIN TRY  
  
    ------------------------------------------------  
    -- VALIDATE ACTION  
    ------------------------------------------------  
    IF ISNULL(@Action,'') = ''  
    BEGIN  
        SET @rmessage = 'Action is required';  
        RETURN;  
    END  
  
    ------------------------------------------------  
    -- INSERT  
    ------------------------------------------------  
    IF UPPER(@Action) = 'INSERT'  
    BEGIN  
  
        ------------------------------------------------  
        -- VALIDATION  
        ------------------------------------------------  
        IF ISNULL(@IdeaTitle,'') = ''  
        BEGIN  
            SET @rmessage = 'Idea Title is required';  
            RETURN;  
        END  
  
        IF @StatusID IS NULL  
        BEGIN  
            SET @rmessage = 'Status is required';  
            RETURN;  
        END  
  
        IF ISNULL(@ProposedIdeasJSON,'') = '' OR ISJSON(@ProposedIdeasJSON)=0  
        BEGIN  
            SET @rmessage = 'Valid Proposed Ideas JSON is required';  
            RETURN;  
        END  
  
        ------------------------------------------------  
        -- DUPLICATE CHECK (CASE INSENSITIVE)  
        ------------------------------------------------  
        IF EXISTS (  
            SELECT 1  
            FROM DNA_Idea  
            WHERE LOWER(LTRIM(RTRIM(IdeaTitle))) = LOWER(LTRIM(RTRIM(@IdeaTitle)))  
              AND ISNULL(IsActive,1)=1  
        )  
        BEGIN  
            SET @rmessage = 'Idea Title already exists';  
            RETURN;  
        END  
  
        ------------------------------------------------  
        -- GET USER SESSION DATA  
        ------------------------------------------------  
        SELECT TOP 1  
            @Company        = COMPANY_NAME,  
            @CompanyCode    = COMPANY_CODE,  
  
            @LocationName   = COUNTRY,  
  
            @DepartmentName = DEPARTMENT,  
            @DepartmentCode = DEPARTMENT_CODE,  
  
            @SubProcessName = SUB_PROCESS,  
            @SubProcessCode = SUB_PROCESS_CODE  
        FROM ScheduleMaster.dbo.All_GeoEmpDataDEX WITH (NOLOCK)  
        WHERE GLOBAL_ID = @LoginEmployee;  
  
        ------------------------------------------------  
        -- LOCATION CODE ALWAYS NULL  
        ------------------------------------------------  
        SET @LocationCode = NULL;  
  
        ------------------------------------------------  
        -- PROBLEM STATEMENT  
        ------------------------------------------------  
        DECLARE @FinalProblemStatement NVARCHAR(500);  
  
        IF @ThemeID IS NULL  
            SET @FinalProblemStatement = @ProblemStatement;  
        ELSE  
            SELECT @FinalProblemStatement = ProblemStatement  
            FROM DNA_Themes  
            WHERE ThemeId = @ThemeID;  
  
        ------------------------------------------------  
        -- INSERT START  
        ------------------------------------------------  
        BEGIN TRANSACTION;  
  
        INSERT INTO DNA_Idea  
        (  
            ThemeID, IdeaTitle, ProblemStatement,CurrentSituation,  
            Company, CompanyCode,  
            LocationCode, LocationName,  
            DepartmentCode, DepartmentName,  
            SubProcessCode, SubProcessName,  
            StatusID, IdeaTypeID, FeasibilityID,  
            IsDraft, IsSubmitted, IsActive,  
            CreatedBy, CreatedIPAddress, CreatedDateTime  
        )  
        VALUES  
        (  
            @ThemeID, @IdeaTitle, @FinalProblemStatement,@CurrentSituation,  
            @Company, @CompanyCode,  
            @LocationCode, @LocationName,  
            @DepartmentCode, @DepartmentName,  
            @SubProcessCode, @SubProcessName,  
            @StatusID, @IdeaTypeID, @FeasibilityID,  
            @IsDraft,  
            CASE WHEN @IsDraft=1 THEN 0 ELSE 1 END,  
            1,  
            @LoginEmployee, @LoginIPAddress, GETDATE()  
        );  
  
        DECLARE @NewIdeaID INT = SCOPE_IDENTITY();  
  
        INSERT INTO DNA_ProposedIdeas  
        (  
            IdeaId, ProposedIdea, DetailedExplanation, CreatedDate  
        )  
        SELECT  
            @NewIdeaID,  
            ProposedIdea,  
            DetailedExplanation,  
            SYSDATETIME()  
        FROM OPENJSON(@ProposedIdeasJSON)  
        WITH  
        (  
            ProposedIdea NVARCHAR(255),  
            DetailedExplanation NVARCHAR(MAX)  
        );  
  
        COMMIT;  
  
        SET @rcode = 1;  
        SET @rmessage =  
            CASE WHEN @IsDraft=1  
                 THEN 'Idea saved as draft successfully'  
                 ELSE 'Idea submitted successfully'  
            END;  
  
        RETURN;  
    END  
  
    IF UPPER(@Action) = 'UPDATE'  
BEGIN  
    IF @IdeaID = 0  
    BEGIN  
        SET @rmessage='Idea ID is required';  
        RETURN;  
    END  
  
    IF NOT EXISTS (SELECT 1 FROM DNA_Idea WHERE IdeaID=@IdeaID AND IsActive=1)  
    BEGIN  
        SET @rmessage='Idea not found';  
        RETURN;  
    END  
  
    IF NOT EXISTS (SELECT 1 FROM DNA_Idea WHERE IdeaID=@IdeaID AND StatusID=7 AND IsActive=1)  
    BEGIN  
        SET @rmessage='Only Draft ideas can be edited';  
        RETURN;  
    END  
  
    ------------------------------------------------  
    -- GET USER DATA FROM SCHEDULEMASTE (same as INSERT)  
    ------------------------------------------------  
    SELECT TOP 1  
        @Company        = COMPANY_NAME,  
        @CompanyCode    = COMPANY_CODE,  
        @LocationName   = COUNTRY,  
        @DepartmentName = DEPARTMENT,  
        @DepartmentCode = DEPARTMENT_CODE,  
        @SubProcessName = SUB_PROCESS,  
        @SubProcessCode = SUB_PROCESS_CODE  
    FROM ScheduleMaster.dbo.All_GeoEmpDataDEX WITH (NOLOCK)  
    WHERE GLOBAL_ID = @LoginEmployee;  
  
    SET @LocationCode = NULL;  
  
    BEGIN TRANSACTION;  
  
    UPDATE DNA_Idea  
    SET  
        ThemeID           = @ThemeID,  
        IdeaTitle         = @IdeaTitle,  
        ProblemStatement  = @ProblemStatement,  
        CurrentSituation = @CurrentSituation,  
        Company           = @Company,  
        CompanyCode       = @CompanyCode,  
        LocationCode      = @LocationCode,  
        LocationName      = @LocationName,  
        DepartmentCode    = @DepartmentCode,  
        DepartmentName    = @DepartmentName,  
        SubProcessCode    = @SubProcessCode,  
        SubProcessName    = @SubProcessName,  
        StatusID          = @StatusID,  
        IdeaTypeID        = @IdeaTypeID,  
        FeasibilityID     = @FeasibilityID,  
        IsDraft           = @IsDraft,  
        IsSubmitted       = CASE WHEN @IsDraft=1 THEN 0 ELSE 1 END,  
        ModifiedBy        = @LoginEmployee,  
        ModifiedIPAddress = @LoginIPAddress,  
        ModifiedDateTime  = GETDATE()  
    WHERE IdeaID = @IdeaID;  
  
    DELETE FROM DNA_ProposedIdeas WHERE IdeaId=@IdeaID;  
  
    INSERT INTO DNA_ProposedIdeas  
    (  
        IdeaId, ProposedIdea, DetailedExplanation, CreatedDate  
    )  
    SELECT  
        @IdeaID, ProposedIdea, DetailedExplanation, SYSDATETIME()  
    FROM OPENJSON(@ProposedIdeasJSON)  
    WITH  
    (  
        ProposedIdea NVARCHAR(255),  
        DetailedExplanation NVARCHAR(MAX)  
    );  
  
    COMMIT;  
  
    SET @rcode=1;  
    SET @rmessage='Idea updated successfully';  
    RETURN;  
END  
  
    ------------------------------------------------  
    -- DELETE (SOFT DELETE)  
    ------------------------------------------------  
    IF UPPER(@Action) = 'DELETE'  
    BEGIN  
        IF @IdeaID=0  
        BEGIN  
            SET @rmessage='Idea ID required';  
            RETURN;  
        END  
  
        IF NOT EXISTS (SELECT 1 FROM DNA_Idea WHERE IdeaID=@IdeaID AND IsActive=1)  
        BEGIN  
            SET @rmessage='Idea not found';  
            RETURN;  
        END  
  
        IF NOT EXISTS (SELECT 1 FROM DNA_Idea WHERE IdeaID=@IdeaID AND StatusID=2 AND IsActive=1)  
        BEGIN  
            SET @rmessage='Only Pending Review ideas can be deleted';  
            RETURN;  
        END  
  
        UPDATE DNA_Idea  
        SET  
            IsActive=0,  
            DeletedBy=@LoginEmployee,  
            DeletedIPAddress=@LoginIPAddress,  
            DeletedDateTime=GETDATE()  
        WHERE IdeaID=@IdeaID;  
  
        SET @rcode=1;  
        SET @rmessage='Idea deleted successfully';  
        RETURN;  
    END  
  
    ------------------------------------------------  
    -- INVALID ACTION  
    ------------------------------------------------  
    SET @rmessage='Invalid Action';  
  
    END TRY  
    BEGIN CATCH  
        IF @@TRANCOUNT>0 ROLLBACK;  
  
        SET @rcode=0;  
        SET @rmessage=ERROR_MESSAGE();  
    END CATCH  
END  






























