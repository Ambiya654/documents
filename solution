}

/*=========================================================
 DELETE IDEA BLOCK
=========================================================*/
$(document).on('click', '.delete-idea-details', function () {
    if ($('.idea-details').length <= 1) {
        bootstrap.Modal.getOrCreateInstance(
            document.getElementById('minIdeaModal')
        ).show();
