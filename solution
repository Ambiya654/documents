========================================= */
var deleteGroupId = 0;

/* OPEN DELETE CONFIRM */
$(document).on('click', '.delete-group', function () {

    deleteGroupId = $(this).data('id');

    bootstrap.Modal.getOrCreateInstance(
        document.getElementById('deleteConfirmModal')
    ).show();
});


/* CONFIRM DELETE */
$(document).on('click', '#btnConfirmDelete', function () {

    if (deleteGroupId == 0) {
        showError('Invalid group selected');
        return;
    }

    $.ajax({
        url: appUrl + 'AIM/SaveUpdateDeleteGroup',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({
            Action: 'DELETE',
            TID: deleteGroupId
        }),

        success: function (res) {

            bootstrap.Modal.getInstance(
                document.getElementById('deleteConfirmModal')
            ).hide();

            if (res.responseCode === 1) {

                showSuccess(res.responseMessage);

                loadGroupList(currentPage);

            } else {
                showError(res.responseMessage);
            }
        },

        error: function () {

            bootstrap.Modal.getInstance(
                document.getElementById('deleteConfirmModal')
            ).hide();

            showError('Unable to delete group');
        }
    });

});
function resetGroupForm() {

