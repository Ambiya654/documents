var appUrl = '';
var selectedThemeID = null;
var editIdeaID = 0;
var carouselThemes = []; // ✅ Store themes globally so cloned slides can access data

// Session data read from hidden fields rendered by Razor
var sessionData = {
    company: '',
    location: '',
    department: '',
    subProcess: ''
};

$(document).ready(function () {
    appUrl = setAppUrl();

    // Read hidden fields set by ViewBag in IdeaLanding()
    sessionData.company = $('#hfCompany').val() || '';
    sessionData.location = $('#hfLocation').val() || '';
    sessionData.department = $('#hfDepartment').val() || '';
    sessionData.subProcess = $('#hfSubProcess').val() || '';

    loadCarousel();
});

$(window).on('load', function () {
    $('.loader-wrapper').hide();
});

/*=========================================================
 POPULATE CONTEXT FIELDS in popup from sessionData
=========================================================*/
function populateContextFields() {
    $('#txtCompany').val(sessionData.company || '');
    $('#txtLocation').val(sessionData.location || '');
    $('#txtDepartment').val(sessionData.department || '');
    $('#txtSubProcess').val(sessionData.subProcess || '');
}

/*=========================================================
 TOAST NOTIFICATIONS (replaces missing showSuccess/showError)
=========================================================*/
function showSuccess(msg) {
    showToast(msg, 'success');
}
function showError(msg) {
    showToast(msg, 'danger');
}
function showToast(msg, type) {
    // remove any existing toast
    $('#dna-toast-container').remove();

    var icon = type === 'success'
        ? '<i class="bi bi-check-circle-fill me-2"></i>'
        : '<i class="bi bi-exclamation-triangle-fill me-2"></i>';

    var html = `
    <div id="dna-toast-container" style="position:fixed;top:20px;right:20px;z-index:99999;min-width:300px;">
        <div class="alert alert-${type} alert-dismissible shadow d-flex align-items-center" role="alert">
            ${icon}
            <div>${msg}</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>`;

    $('body').append(html);
    setTimeout(function () { $('#dna-toast-container').fadeOut(400, function () { $(this).remove(); }); }, 4000);
}

/*=========================================================
 LOAD CAROUSEL
=========================================================*/
function loadCarousel() {
    $.ajax({
        url: appUrl + 'AIM/GetActiveThemesForCarousel',
        type: 'POST',
        contentType: 'application/json',

        success: function (res) {
            if (res.responseCode === 1 && res.responseData) {
                var data;
                try {
                    data = typeof res.responseData === 'string'
                        ? JSON.parse(res.responseData)
                        : res.responseData;
                } catch (e) {
                    console.error('Carousel parse error:', e);
                    bindCarousel([]);
                    return;
                }
                bindCarousel(data);
            } else {
                bindCarousel([]);
            }
        },

        error: function () {
            bindCarousel([]);
        }
    });
}

/*=========================================================
 BIND CAROUSEL
 NOTE: Static banner image always used per requirement.
       ThemeTitle / ProblemStatement / CurrentSituation come from DB.
=========================================================*/
function bindCarousel(themes) {

    // Store globally so click handler can access even on cloned owl slides
    carouselThemes = themes || [];

    // destroy existing owl if already initialized
    if ($('.ideation-slider').hasClass('owl-loaded')) {
        $('.ideation-slider').trigger('destroy.owl.carousel');
        $('.ideation-slider').removeClass('owl-loaded owl-hidden');
        $('.ideation-slider').html('');
    }

    var html = '';

    if (!carouselThemes || carouselThemes.length === 0) {
        html = `
        <div class="item" style="background-image: url('${appUrl}assets/images/banner-one.png');">
            <div class="banner-text">
                <h6>Be the reason for the next <span>big improvement,</span><br>
                    Share your <span>efficiency-boosting ideas</span> today.</h6>
                <a href="javascript:;" class="btn btn-lightblue initiate-btn add-new" title="Add Ideas">
                    <i class="bi bi-plus icon-text normal-icon"></i>
                    <i class="bi bi-rocket-takeoff-fill icon-text hover-icon"></i>
                    Add Ideas
                </a>
            </div>
        </div>`;
    } else {
        $.each(carouselThemes, function (i, theme) {
            var themeTitle = theme.ThemeTitle || theme.themeTitle || 'Share your ideas today.';

            // ✅ Use array INDEX as data attr — not the actual text values
            // This works even on owl cloned slides
            html += `
            <div class="item" style="background-image: url('${appUrl}assets/images/banner-one.png');">
                <div class="banner-text">
                    <h6>${escapeHtml(themeTitle)}</h6>
                    <a href="javascript:;"
                       class="btn btn-lightblue initiate-btn add-new-theme"
                       data-themeindex="${i}"
                       title="Add Ideas for this Theme">
                        <i class="bi bi-plus icon-text normal-icon"></i>
                        <i class="bi bi-rocket-takeoff-fill icon-text hover-icon"></i>
                        Add Ideas
                    </a>
                </div>
            </div>`;
        });
    }

    $('.ideation-slider').html(html);

    $('.ideation-slider').owlCarousel({
        loop: carouselThemes.length > 1,
        margin: 0,
        nav: true,
        dots: true,
        autoplay: carouselThemes.length > 1,
        autoplayTimeout: 4000,
        items: 1
    });
}

/*=========================================================
 HELPER: escape HTML to prevent XSS in carousel titles
=========================================================*/
function escapeHtml(str) {
    return $('<div>').text(str).html();
}

/*=========================================================
 OPEN POPUP — FRESH IDEA (top-right button & listing Add btn)
 PS + CS editable, nothing prefilled from theme
=========================================================*/
$(document).on('click', '.add-new', function () {
    resetIdeaForm();
    selectedThemeID = null;
    editIdeaID = 0;

    // PS + CS fully editable
    $('#txtProblemStatement').prop('disabled', false).val('');
    $('#txtCurrentSituation').prop('disabled', false).val('');

    // Populate Company/Location/Department/SubProcess from session
    populateContextFields();

    $('.addIdeaPopup .popup-title').text('Create New Idea');
    $('#btnSaveIdea').text('Save Idea').attr('data-id', 0);

    openPopup();
});

/*=========================================================
 OPEN POPUP — THEME IDEA (carousel button)
 PS + CS prefilled from carouselThemes array using index
 Owl carousel clones slides so data-attrs get duplicated —
 using array index lookup is the safe approach
=========================================================*/
$(document).on('click', '.add-new-theme', function () {
    resetIdeaForm();
    editIdeaID = 0;

    // Get theme from global array using index — safe even on cloned slides
    var idx = parseInt($(this).data('themeindex'));
    var theme = carouselThemes[idx];

    if (!theme) {
        openPopup();
        return;
    }

    selectedThemeID = theme.ThemeId || theme.themeId || null;

    var ps = theme.ProblemStatement || theme.problemStatement || '';
    var cs = theme.CurrentSituation || theme.currentSituation || '';

    // Prefill PS + CS from theme and lock them
    $('#txtProblemStatement').val(ps).prop('disabled', true);
    $('#txtCurrentSituation').val(cs).prop('disabled', true);

    populateContextFields();

    $('.addIdeaPopup .popup-title').text('Create New Idea');
    $('#btnSaveIdea').text('Save Idea').attr('data-id', 0);

    openPopup();
});

/*=========================================================
 OPEN POPUP — EDIT IDEA (eye/pencil icon in listing)
 Triggered by clicking the edit action; caller must set
 data-id, data-title, data-ps, data-cs, data-draft,
 and pass in proposed ideas JSON as data-ideas.
=========================================================*/
$(document).on('click', '.edit-idea', function () {
    resetIdeaForm();

    editIdeaID = parseInt($(this).data('id')) || 0;
    selectedThemeID = parseInt($(this).data('themeid')) || null;

    var title = $(this).data('title') || '';
    var ps = decodeURIComponent($(this).data('ps') || '');
    var cs = decodeURIComponent($(this).data('cs') || '');
    var isDraft = $(this).data('draft') == true || $(this).data('draft') == 'true';

    $('#txtIdeaTitle').val(title);
    $('#txtProblemStatement').val(ps).prop('disabled', !!selectedThemeID);
    $('#txtCurrentSituation').val(cs).prop('disabled', !!selectedThemeID);

    // Populate Company/Location/Department/SubProcess from session
    populateContextFields();

    // populate proposed ideas blocks
    var ideasJson = $(this).data('ideas');
    var ideas = [];
    try {
        ideas = typeof ideasJson === 'string' ? JSON.parse(ideasJson) : (ideasJson || []);
    } catch (e) { ideas = []; }

    // clear existing blocks
    $('.idea-details').not(':first').remove();
    if (ideas.length > 0) {
        $('.idea-details:first .proposed-idea-text').val(ideas[0].ProposedIdea || ideas[0].proposedIdea || '');
        $('.idea-details:first .detailed-explanation-text').val(ideas[0].DetailedExplanation || ideas[0].detailedExplanation || '');
        for (var i = 1; i < ideas.length; i++) {
            addIdeaBlock();
            var blocks = $('.idea-details');
            blocks.last().find('.proposed-idea-text').val(ideas[i].ProposedIdea || ideas[i].proposedIdea || '');
            blocks.last().find('.detailed-explanation-text').val(ideas[i].DetailedExplanation || ideas[i].detailedExplanation || '');
        }
    }

    $('.addIdeaPopup .popup-title').text('Edit Idea');
    $('#btnSaveIdea').text('Update Idea').attr('data-id', editIdeaID);

    openPopup();
});

/*=========================================================
 OPEN / CLOSE HELPERS
=========================================================*/
function openPopup() {
    $('.addIdeaPopup').addClass('active');
    $('#addUserOverlay').fadeIn();
    $('body').addClass('no-scroll');
