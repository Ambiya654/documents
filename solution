 PAGE CLICK
=========================================================*/
$(document).on('click', '.group-page-click', function () {

    if ($(this).closest('.page-item').hasClass('disabled'))
        return;

    var page = $(this).data('page');

    loadGroupList(page);
});
/* =========================================
